# JCorp AI Readiness Assessment — local environment
# Copy to .env and adjust. Never commit a real .env.

# SQLite for local use. Swap the datasource provider in prisma/schema.prisma to
# "postgresql" or "sqlserver" and point this at the managed database on deploy.
DATABASE_URL="file:./prisma/dev.db"

# Shared password for the management dashboard at /admin.
ADMIN_PASSWORD="changeme"

# Secret used to sign the admin session cookie. Use a long random string.
SESSION_SECRET="change-this-to-a-long-random-string"

# Minimum responses required before a segment's scores are shown.
NEXT_PUBLIC_MIN_SEGMENT_SIZE=3
